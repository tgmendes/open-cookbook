    "/api/v1/shopping-lists/{week}": {
      "get": {
        "description": "Read aggregated ingredients from the week's planned recipes. Quantities are per recipe occurrence, not adjusted to diners. Shopping checkmarks are local to the browser and are not part of this API.",
        "parameters": [
          {
            "in": "path",
            "name": "week",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "Any ISO date in the requested week; normalized to Monday."
            }
          }
        ],
        "operationId": "get_shopping_list",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "week_start",
                        "items"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "name",
                              "quantity",
                              "unit"
                            ],
                            "additionalProperties": false,
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "unit": {
