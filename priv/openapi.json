                                "nullable": true,
                                "maxLength": 20000
                              },
                              "quantity": {
                                "type": "string",
                                "nullable": true,
                                "maxLength": 20000
                              }
                            }
                          }
                        },
                        "week_start": {
                          "type": "string",
                          "format": "date"
                        }
                      }
                    }
                  }
                }
