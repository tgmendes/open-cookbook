{
  "info": {
    "version": "1.0.0",
    "description": "Private recipe storage and weekly meal planning. Every cookbook operation requires the owner's API token.",
    "title": "Open Cookbook"
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "unauthorized",
                  "not_found",
                  "validation_error",
                  "conflict"
                ]
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      },
      "Ingredient": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1
          },
          "position": {
            "type": "integer",
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000
          },
          "quantity": {
            "type": "string",
            "description": "Text quantity, including fractions such as 1/2 or phrases such as to taste.",
            "nullable": true,
            "maxLength": 20000
          },
          "group_name": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000
          }
        }
      },
      "IngredientInput": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000
          },
          "quantity": {
            "type": "string",
            "description": "Text quantity, including fractions such as 1/2 or phrases such as to taste.",
            "nullable": true,
            "maxLength": 20000
          },
          "group_name": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000
          }
        }
      },
      "MealPlan": {
        "type": "object",
        "required": [
          "week_start",
          "entries"
        ],
        "additionalProperties": false,
        "properties": {
          "week_start": {
            "type": "string",
            "format": "date"
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "day_of_week",
                "meal_type",
                "position",
                "recipe_id",
                "recipe_title"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "position": {
                  "type": "integer",
                  "minimum": 0
                },
                "day_of_week": {
                  "maximum": 7,
                  "type": "integer",
                  "minimum": 1
                },
                "meal_type": {
                  "type": "string",
                  "enum": [
                    "lunch",
                    "dinner"
                  ]
                },
                "recipe_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "recipe_title": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Recipe": {
        "type": "object",
        "required": [
          "id",
          "description",
          "title",
          "source_url",
          "ingredients",
          "steps",
          "tags",
          "inserted_at",
          "notes",
          "updated_at",
          "cook_time_minutes",
          "image_url",
          "prep_time_minutes",
          "servings",
          "source_type",
          "total_time_minutes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000
          },
          "title": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000
          },
          "ingredients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ingredient"
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Step"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100
          },
          "inserted_at": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "cook_time_minutes": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          },
          "image_url": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000
          },
          "prep_time_minutes": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          },
          "servings": {
            "type": "integer",
            "minimum": 1,
            "nullable": true
          },
          "source_type": {
            "default": "manual",
            "type": "string",
            "enum": [
              "manual",
              "scraped",
              "generated"
            ]
          },
          "total_time_minutes": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          }
        }
      },
      "RecipeCreate": {
        "type": "object",
        "required": [
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000
          },
          "title": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000
          },
          "ingredients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IngredientInput"
            },
            "maxItems": 200
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StepInput"
            },
            "maxItems": 200
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000
          },
          "cook_time_minutes": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          },
          "image_url": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000
          },
          "prep_time_minutes": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          },
          "servings": {
            "type": "integer",
            "minimum": 1,
            "nullable": true
          },
          "source_type": {
            "default": "manual",
            "type": "string",
            "enum": [
              "manual",
              "scraped",
              "generated"
            ]
          }
        }
      },
      "RecipeSummary": {
        "type": "object",
        "required": [
          "id",
          "description",
          "title",
          "source_url",
          "tags",
          "inserted_at",
          "notes",
          "updated_at",
          "cook_time_minutes",
          "image_url",
          "prep_time_minutes",
          "servings",
          "source_type",
          "total_time_minutes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000
          },
          "title": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100
          },
          "inserted_at": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "cook_time_minutes": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          },
          "image_url": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000
          },
          "prep_time_minutes": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          },
          "servings": {
            "type": "integer",
            "minimum": 1,
            "nullable": true
          },
          "source_type": {
            "default": "manual",
            "type": "string",
            "enum": [
              "manual",
              "scraped",
              "generated"
            ]
          },
          "total_time_minutes": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          }
        }
      },
      "RecipeUpdate": {
        "type": "object",
        "required": [],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000
          },
          "title": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000
          },
          "ingredients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IngredientInput"
            },
            "maxItems": 200
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StepInput"
            },
            "maxItems": 200
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000
          },
          "cook_time_minutes": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          },
          "image_url": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000
          },
          "prep_time_minutes": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          },
          "servings": {
            "type": "integer",
            "minimum": 1,
            "nullable": true
          },
          "source_type": {
            "default": "manual",
            "type": "string",
            "enum": [
              "manual",
              "scraped",
              "generated"
            ]
          }
        }
      },
      "Step": {
        "type": "object",
        "required": [
          "instruction"
        ],
        "additionalProperties": false,
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 0
          },
          "instruction": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1
          },
          "duration_minutes": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          }
        }
      },
      "StepInput": {
        "type": "object",
        "required": [
          "instruction"
        ],
        "additionalProperties": false,
        "properties": {
          "instruction": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1
          },
          "duration_minutes": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "cookbookToken": {
        "scheme": "bearer",
        "type": "http",
        "description": "Create a revocable token in the cookbook's Connections page. Store it only in Speakeasy's secure credential settings, never in tool arguments or chat."
      }
    }
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/v1/meal-plans/{week}": {
      "get": {
        "description": "Read a week, normalized to Monday. Missing plans return empty entries without creating records.",
        "parameters": [
          {
            "in": "path",
            "name": "week",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "Any ISO date in the requested week; normalized to Monday."
            }
          }
        ],
        "operationId": "get_meal_plan",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/MealPlan"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired, or revoked token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found in the owner's cookbook.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meal-plans/{week}/slots/{day}/{meal}": {
      "put": {
        "description": "Replace ONLY this day's lunch or dinner with the ordered recipe_ids. Existing recipes in this slot are removed; other slots are untouched. An empty array clears the slot. Read the plan first when appending. Retrying the same request does not duplicate entries.",
        "parameters": [
          {
            "in": "path",
            "name": "week",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "Any ISO date in the requested week; normalized to Monday."
            }
          },
          {
            "in": "path",
            "name": "day",
            "required": true,
            "schema": {
              "maximum": 7,
              "type": "integer",
              "description": "Monday=1, Sunday=7",
              "minimum": 1
            }
          },
          {
            "in": "path",
            "name": "meal",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "lunch",
                "dinner"
              ]
            }
          }
        ],
        "operationId": "replace_meal_slot",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/MealPlan"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired, or revoked token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found in the owner's cookbook.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "recipe_ids"
                ],
                "additionalProperties": false,
                "properties": {
                  "recipe_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "maxItems": 50
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profile": {
      "get": {
        "description": "Read the owner's unit preference before composing recipes.",
        "operationId": "get_cookbook_profile",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "unit_system",
                        "ingredient_units"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "unit_system": {
                          "type": "string",
                          "enum": [
                            "metric",
                            "imperial"
                          ]
                        },
                        "ingredient_units": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired, or revoked token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found in the owner's cookbook.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recipes": {
      "get": {
        "description": "Search stored recipes by title/ingredient and tag. Follow pagination until has_more is false.",
        "parameters": [
          {
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "tag",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "operationId": "list_recipes",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RecipeSummary"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "required": [
                        "limit",
                        "offset",
                        "has_more"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "offset": {
                          "type": "integer"
                        },
                        "limit": {
                          "type": "integer"
                        },
                        "has_more": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired, or revoked token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found in the owner's cookbook.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "description": "Save a complete recipe. Generate a fresh Idempotency-Key for each intentional creation and reuse it for retries of the same body. The original response is replayed for 24 hours, even if the recipe is subsequently edited or deleted. Reusing a key for a different body returns 409.",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            }
          }
        ],
        "operationId": "create_recipe",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Recipe"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired, or revoked token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found in the owner's cookbook.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The same key was already used for a different recipe.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeCreate"
              }
            }
          }
        }
      }
    },
    "/api/v1/recipes/{id}": {
      "get": {
        "description": "Read a stored recipe with ingredients and steps in cooking order.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "operationId": "get_recipe",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Recipe"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired, or revoked token.",
            "content": {
              "application/json": {
